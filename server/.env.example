DATABASE_URL=postgresql://learnpilot:learnpilot@localhost:5432/learnpilot?schema=public
SESSION_SECRET=change-me-in-production-use-a-long-random-string
COOKIE_SECRET=change-me-in-production-use-another-long-random-string
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000
# Google OAuth — set these to enable "Continue with Google" login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:4000

# ── Self-hosted POWERFUL model (your own GPU server) — أولوية رقم 1 ──
# أجّر سيرفر GPU (RunPod / Vast.ai) وشغّل عليه موديل قوي، وحط رابط الـ API هنا.
# مثال: CUSTOM_LLM_BASE_URL=https://abc123-8000.proxy.runpod.net/v1
# الموديلات القوية المقترحة للعربي: qwen2.5:32b | llama-3.3-70b | allam-2-13b | jais-30b
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=qwen2.5:32b
# CUSTOM_LLM_API_KEY=local
# Free AI providers (tried in order: custom-self-hosted -> groq -> google -> ollama).
# All three are free / no credit card needed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
# Local Ollama fallback (free + unlimited, no tokens). Set to false if not running.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Optional free providers of the AI cascade (tried in order, skipped when empty) ──
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# DEEPINFRA_API_KEY=

# ── RAG embeddings (HuggingFace Inference) ──
# Without HUGGINGFACE_API_KEY the RAG endpoints refuse to answer (no evidence),
# they never invent facts. The model must be a feature-extraction model.
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBED_MODEL=intfloat/multilingual-e5-base
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── Voice tutor (server-side STT/TTS — reuses the Groq key above) ──
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI
# Optional Arabic voice; when empty the client falls back to browser speech.
# GROQ_TTS_VOICE_AR=

# ── Code sandbox ──
# Python interpreter binary (default: `python` on Windows, `python3` elsewhere).
# JavaScript runs inside node:vm and needs no extra runtime.
# PYTHON_BIN=

# ── Misc ──
# AUTH_RATE_LIMIT_MAX=20
# UPLOAD_DIR=
