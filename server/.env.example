DATABASE_URL=postgresql://learnpilot:learnpilot@localhost:5432/learnpilot?schema=public
# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-use-a-long-random-string
COOKIE_SECRET=change-me-in-production-use-another-long-random-string
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000
# Google OAuth — set these to enable "Continue with Google" login.
# Console: https://console.cloud.google.com/apis/credentials  -> Create credentials -> OAuth client ID -> Web application
# NOTE: this is a DIFFERENT console from GOOGLE_AI_API_KEY below (AI Studio).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:4000

# ── Self-hosted POWERFUL model (your own GPU server) — أولوية رقم 1 ──
# أجّر سيرفر GPU (RunPod https://runpod.io  |  Vast.ai https://vast.ai) وشغّل عليه موديل قوي، وحط رابط الـ API هنا.
# مثال: CUSTOM_LLM_BASE_URL=https://abc123-8000.proxy.runpod.net/v1
# الموديلات القوية المقترحة للعربي: qwen2.5:32b | llama-3.3-70b | allam-2-13b | jais-30b
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=qwen2.5:32b
# CUSTOM_LLM_API_KEY=local
# ── Two-space HF plan (free, no card): Space-1 (7b) = أولوية 1، Space-2 (8b) = أولوية 2 ──
# كل Space شايل موديلا واحدا خلف بوابة توكن خاصة به. لو Space-1 نايم/واقع،
# السلسلة تسقط تلقائيا على Space-2 ثم Groq/Gemini ثم Ollama المحلي.
# التفاصيل وخطوات النشر: docs/HF_SPACES_PLAN.md
# Space-1 (الحساب الأول — qwen2.5:7b، الأسرع):
# CUSTOM_LLM_BASE_URL=https://<user-1>-learnpilot-7b.hf.space/v1
# CUSTOM_LLM_MODEL=qwen2.5:7b
# CUSTOM_LLM_API_KEY=<token-space-1>
# Space-2 (الحساب الثاني — qwen3:8b، الأقوى عربيا):
# CUSTOM_LLM_2_BASE_URL=https://<user-2>-learnpilot-8b.hf.space/v1
# CUSTOM_LLM_2_MODEL=qwen3:8b
# CUSTOM_LLM_2_API_KEY=<token-space-2>
# Free AI providers (tried in order: custom-self-hosted -> groq -> google -> ollama).
# All three are free / no credit card needed.
# Groq (free, also powers voice STT/TTS) — get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio / Gemini (free) — get key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
# Local Ollama fallback (free + unlimited, no tokens, NO API key needed).
# Install: https://ollama.com/download  |  model library: https://ollama.com/library
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── Optional free providers of the AI cascade (tried in order, skipped when empty) ──
# OpenRouter    — get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Cerebras      — get key: https://cloud.cerebras.ai/   (chat needs quota; 402 without it)
# CEREBRAS_API_KEY=
# Mistral       — get key: https://console.mistral.ai/api-keys/
# MISTRAL_API_KEY=
# DeepInfra     — get key: https://deepinfra.com/dash/api_keys
# DEEPINFRA_API_KEY=
# GitHub Models — get token: https://github.com/settings/tokens (grant "Models: read")
# GITHUB_TOKEN=
# GITHUB_MODEL=openai/gpt-4o-mini

# ── RAG embeddings (HuggingFace Inference) ──
# Get token: https://huggingface.co/settings/tokens -> grant "Make calls to Inference Providers".
# Without HUGGINGFACE_API_KEY the RAG endpoints refuse to answer (no evidence),
# they never invent facts. The model must be a feature-extraction model.
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBED_MODEL=intfloat/multilingual-e5-base
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── Voice tutor (server-side STT/TTS — reuses the Groq key above) ──
GROQ_STT_MODEL=whisper-large-v3-turbo
# Groq retired `playai-tts` (Mar 2026 — API returns 400 "decommissioned").
# Current speech model; override if Groq renames it again.
GROQ_TTS_MODEL=canopylabs-orion-v1
GROQ_TTS_VOICE=Fritz-PlayAI
# Optional Arabic voice; when empty the client falls back to browser speech.
# GROQ_TTS_VOICE_AR=

# ── Code sandbox ──
# Python interpreter binary (default: `python` on Windows, `python3` elsewhere).
# JavaScript runs inside node:vm and needs no extra runtime.
# PYTHON_BIN=

# ── Misc ──
# AUTH_RATE_LIMIT_MAX=20
# UPLOAD_DIR=
